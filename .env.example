# 실제 키가 담긴 .env 파일은 절대 GitHub에 올리지 않는다.
# 이 파일을 복사해서 .env로 만들고 실제 발급받은 키를 채워 넣는다.
# cp .env.example .env

# ── LLM ─────────────────────────────────────────────
# Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=

# Claude(Anthropic API)를 대신 쓰고 싶을 때만 필요
# LLM_PROVIDER=anthropic일 때 사용
ANTHROPIC_API_KEY=

# gemini 또는 anthropic
# 비워두면 기본값 gemini로 동작한다.
LLM_PROVIDER=gemini

# ── 수집 대상 ───────────────────────────────────────
# 조사 결과·seed에 기록되는 수집 서버 이름 (EC2에서는 `hostname` 명령 결과를 넣는다). 비우면 web-01
HOST=

# ── 로그 경로 (EC2 서버의 실제 로그 파일을 직접 읽는다) ──
# 수집과 조사 모두 1차 탐지팀 공통 정규화 함수를 사용한다. 웹은 Apache 형식이다.
WEB_LOG_LOCAL_PATH=/var/log/apache2/access.log
AUTH_LOG_LOCAL_PATH=/var/log/auth.log
AUDIT_LOG_LOCAL_PATH=/var/log/audit/audit.log
NETWORK_LOG_LOCAL_PATH=/var/log/suricata/eve.json

# 로컬 개발(내 PC)에서는 위 경로 대신 샘플 파일을 가리킨다.
# sample_logs/는 저장소에 없다(실제 트래픽 포함) — 팀원에게 받거나 scripts/fetch_sample_from_ec2.py로 받는다.
# WEB_LOG_LOCAL_PATH=sample_logs/sample_apache_web.log
# AUTH_LOG_LOCAL_PATH=sample_logs/sample_auth.log
# AUDIT_LOG_LOCAL_PATH=sample_logs/sample_audit.log
# NETWORK_LOG_LOCAL_PATH=sample_logs/sample_network.log
# 연도 없는 syslog(auth) 샘플의 실제 연도. 비우면 조회 구간의 연도를 쓴다(EC2 실시간 로그는 비워 둔다).
# AUTH_LOG_YEAR=2026

# seed 생성(triage)에 넘길 계층별 마지막 이벤트 수(audit 여러 줄 = 이벤트 한 개).
# 로그 파일 경로를 쓰면 시각과 관계없이 파일 끝에서 이만큼을 본다.
RAW_LOG_LOCAL_MAX_LINES=50

# (선택) 이 서버 이름과 다른 host로 조회하면 거부한다. 비워 두면 검사하지 않는다.
# LOG_LOCAL_HOST=

# ── 오프라인 테스트/데모는 .env나 API 키 없이 실행한다 ──
# python -m pytest -q
# python -m scripts.demo_abcd

# S3 모드(현재 미사용): 위 *_LOG_LOCAL_PATH를 비우면 S3에서 읽는다. 그때만 아래가 필요하다.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AUDIT_LOG_BUCKET=
# RAW_LOG_WINDOW_MINUTES=10    # S3 모드 seed 생성 시 "최근 N분" 조회 구간
