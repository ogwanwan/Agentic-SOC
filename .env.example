# 실제 키가 담긴 .env 파일은 절대 GitHub에 올리지 않는다.
# 이 파일을 복사해서 .env로 만들고 실제 발급받은 키를 채워 넣는다.
# cp .env.example .env

# Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=

# Claude(Anthropic API)를 대신 쓰고 싶을 때만 필요
# LLM_PROVIDER=anthropic일 때 사용
ANTHROPIC_API_KEY=

# gemini 또는 anthropic
# 비워두면 기본값 gemini로 동작한다.
LLM_PROVIDER=gemini

# 로컬에 aws configure를 해뒀다면 아래 값은 비워둬도 됨
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AUDIT_LOG_BUCKET=ogwanwan-shop-bucket

HOST=web-01
RAW_LOG_WINDOW_MINUTES=10

# 아래는 저장소에 포함된 샘플 파일이다. 프로젝트 루트에서 실행한다.
# 수집과 조사 모두 같은 공통 정규화 함수를 사용한다. 웹은 Apache 형식이다.
# 내 로그로 실행할 때 각 경로를 바꾼다. S3를 쓰려면 해당 LOCAL_PATH 값을 비운다.
WEB_LOG_LOCAL_PATH=sample_logs/sample_apache_web.log
AUTH_LOG_LOCAL_PATH=sample_logs/sample_auth.log
AUDIT_LOG_LOCAL_PATH=sample_logs/sample_audit.log
NETWORK_LOG_LOCAL_PATH=sample_logs/sample_network.log

# 연도 없는 syslog(auth) 샘플의 실제 연도. 다른 연도 로그로 바꿀 때 함께 변경한다.
AUTH_LOG_YEAR=2026
# 로컬 파일의 수집 서버. HTTP Host 헤더(example.test 등)와는 다른 값이다.
LOG_LOCAL_HOST=web-01
# 로컬 수집에서 계층별 마지막 완성 이벤트 수(audit 여러 줄 = 이벤트 한 개).
RAW_LOG_LOCAL_MAX_LINES=30
# S3는 계층별 버킷을 지정할 수 있다. 미지정 시 코드의 기본 버킷을 사용한다.
# WEB_LOG_BUCKET=
# AUTH_LOG_BUCKET=
# NETWORK_LOG_BUCKET=
# 오프라인 통합 테스트/데모는 .env나 API 키 없이 실행한다.
# python -m pytest -q
# python -m scripts.demo_abcd
