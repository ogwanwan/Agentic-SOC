# /etc/agentic-soc/env 로 복사해서 쓴다 (root:soc, 0640).
# systemd EnvironmentFile 형식: 값 뒤에 인라인 주석(#)을 붙이면 주석까지 값이 된다. 주석은 줄 단위로만.

# 로그 경로 — 로테이트 파일(access.log.1, access.log.2.gz …)은 같은 디렉터리에서 자동으로 찾는다
APACHE_LOG_PATH=/var/log/apache2/access.log
AUTH_LOG_PATH=/var/log/auth.log
SURICATA_LOG_PATH=/var/log/suricata/eve.json
AUDIT_LOG_PATH=/var/log/audit/audit.log

# 서버 자기 공인 IP (wp-cron 자기호출 제외용)
SERVER_PUBLIC_IP=54.180.11.0

# AUTH_LOG_YEAR 는 비워 둔다 — 비우면 현재 날짜 기준으로 연도를 정하고 12월→1월 경계도 처리한다.
# 고정값을 넣으면 새해부터 auth 시각이 1년 어긋난다.

# 트리아지 LLM 재검토(없으면 결정론 결과만 사용)
ANTHROPIC_API_KEY=
